{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/unixtime-session-start.sh",
            "timeout": 10,
            "statusMessage": "Starting session timer"
          }
        ]
      }
    ]
  }
}
